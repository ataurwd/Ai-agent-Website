# Formspree Form ID Integration
# 1. Sign up at https://formspree.io
# 2. Create a new form (e.g. "Opsvian AI - Demo & Inquiries")
# 3. Set your target recipient email in the Formspree dashboard (Settings -> Target Email)
# 4. Copy your form ID (the 8-character string from your endpoint URL: https://formspree.io/f/<YOUR_FORM_ID>)
# 5. Paste it below and restart your development server

NEXT_PUBLIC_FORMSPREE_FORM_ID=

# Website base URL for canonical metadata and sitemap (optional for local dev)
NEXT_PUBLIC_SITE_URL=https://opsvian.ai
